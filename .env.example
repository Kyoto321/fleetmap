# ============================================================
# Fleet Platform — Environment Variables
# Copy to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# ── PostgreSQL ─────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_strong_password
DATABASE_URL=postgresql+asyncpg://postgres:changeme_strong_password@localhost:5432/fleetdb

# ── Redis ──────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis_password
REDIS_URL=redis://:changeme_redis_password@localhost:6379/0

# ── JWT (RS256) ────────────────────────────────────────────
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── Kafka ──────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── App ────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
ROOT_DOMAIN=localhost

# ── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:80
NEXT_PUBLIC_WS_URL=ws://localhost:80
NEXT_PUBLIC_ROOT_DOMAIN=localhost
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# ── Monitoring ─────────────────────────────────────────────
GRAFANA_PASSWORD=admin
